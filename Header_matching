def select_paths_and_analyze():
    # Hide the main root window framework
    root = tk.Tk()
    root.withdraw()
    
    # 1. Prompt for Template File Selection
    messagebox.showinfo("Step 1", "Please select your perfect/correct Benchmark Template Excel file.")
    template_file = filedialog.askopenfilename(
        title="Select Benchmark Template File",
        filetypes=[("Excel Files", "*.xlsx *.xls")]
    )
    
    if not template_file:
        print("[CANCELLED] No template selected.")
        return
        
    # 2. Prompt for Target Folder Selection
    messagebox.showinfo("Step 2", "Please select the folder containing the files you want to audit (QC Sheet Backup).")
    target_dir = filedialog.askdirectory(title="Select Folder to Audit")
    
    if not target_dir:
        print("[CANCELLED] No folder directory selected.")
        return
        
    # Run the validation pipeline
    run_verification(template_file, target_dir)
    messagebox.showinfo("Complete", "Header check complete! Please check your terminal for results.")

if __name__ == "__main__":
    select_paths_and_analyze()